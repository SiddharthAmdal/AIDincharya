# Google AI Studio / Gemini API Key Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Provider selection (options: gemini, custom_llm, puter, nvidia)
LLM_PROVIDER=gemini

# Default model (e.g., gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro)
DEFAULT_MODEL=gemini-3.6-flash

# Optional Custom / Local LLM settings
# CUSTOM_LLM_BASE_URL=http://localhost:8000/v1
# CUSTOM_LLM_API_KEY=custom-llm-key
# CUSTOM_LLM_MODEL=custom-ayurveda-llm

# FastAPI Settings
DEBUG=True
