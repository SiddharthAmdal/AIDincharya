# AI Dincharya Environment Configuration Template
# Copy this file to .env and provide your actual API keys. Never commit real keys.

# LLM Provider Selection: 'nvidia' (default) or 'openai' or 'puter'
LLM_PROVIDER=nvidia

# NVIDIA NIM API Settings
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your_nvidia_api_key_here

# Default and Fallback Model IDs
DEFAULT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
FALLBACK_MODEL=openai/gpt-oss-20b

# Puter AI Settings (Alternative provider)
PUTER_BASE_URL=https://api.puter.com/puterai/openai/v1/
PUTER_API_KEY=your_puter_api_key_here

# Application Settings
DEBUG=False
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001

# Web Push (VAPID) Settings (RFC 8292)
# Generate fresh keys via: .venv/bin/python -m src.notifications.generate_vapid_keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CLAIMS_EMAIL=mailto:admin@aidincharya.internal

